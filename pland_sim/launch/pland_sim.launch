<launch>
  <!-- We resume the logic in empty_world.launch, changing only the name of the world to be launched -->
  <arg name="rviz" default="true" />
  <arg name="gui" default="true" />
  <arg name="output" default="screen" />
  
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find pland_sim)/worlds/pland.world"/>
    <arg name="gui" value="$(arg gui)" />
    <arg name="output" value="$(arg output)" />
    <env name="GAZEBO_MODEL_PATH" value="$(find pland_sim)/models:$(optenv GAZEBO_MODEL_PATH)" />
  </include>

  <include file="$(find mavros)/launch/apm.launch">
    <arg name="fcu_url" value="tcp://127.0.0.1:5760"/>
    <arg name="log_output" value="$(arg output)"/>
    <arg name="respawn_mavros" value="true"/>
  </include>

  <node name="sitl" pkg="pland_sim" type="start_sitl.sh"/>

  <node name="sim_controller" pkg="pland_sim" type="sim_controller.py"/>

  <include file="$(find pland_controller)/launch/pland_controller.launch">
  </include>

  <include file="$(find pland_detector)/launch/pland_detector.launch">
  </include>

</launch>