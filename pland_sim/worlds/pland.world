<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://iris_with_gimbal</uri>
      <name>iris_demo</name>
      <pose>0.2 0.2 0.4 0 0 0</pose>
    </include>

    <include>
      <uri>model://apriltag</uri>
      <name>apriltag</name>
      <pose>-2 -2 0.1 0 0 0</pose>
    </include>

  </world>
</sdf>